generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String      @id
  name      String
  nickname  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  posts     Post[]
  viewedPosts Post[] @relation("PostViewers")
  updatedAt  DateTime?
  comments  Comment[]
  verificationExpires DateTime @default(now())
  isVerified Boolean   @default(false)
  toDos     ToDo[]
  sentPms    Pm[] @relation("SentMessages")
  receivedPms Pm[] @relation("ReceivedMessages")
  alarms    Alarm[]
}

model Post {
  id         Int      @id @default(autoincrement())
  title      String
  content    String   @db.MediumText
  createdAt  DateTime @default(now())
  updatedAt  DateTime?
  views      Int      @default(0)
  author     User?    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId   String?
  password   String?
  tags       Tag[]
  isPrivate  Boolean  @default(false)
  viewers    User[]    @relation("PostViewers")
  comments   Comment[]
}

model Comment {
  id         Int      @id @default(autoincrement())
  content    String   @db.MediumText
  createdAt  DateTime @default(now())
  updatedAt  DateTime?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId   String?
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     Int
  replies    Comment[] @relation("CommentReplies")
  parent     Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  parentId   Int?
  password   String?
}

model Tag {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  posts Post[] @relation
}

model ToDo {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  isCompleted Boolean   @default(false)
  date        DateTime
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
}

model Pm {
  id         Int  @id @default(autoincrement())
  title      String
  content    String
  createdAt  DateTime @default(now())
  sender       User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  senderId     String
  receiver       User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId     String
  isDeletedBySender   Boolean   @default(false)
  isDeletedByReceiver Boolean   @default(false)
}

model Alarm {
  id          Int    @id @default(autoincrement())
  message    String
  createdAt  DateTime @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  count      Int
}